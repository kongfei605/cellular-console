[Unit]
Description=EC20 Console - private status, SMS inbox and voice control
Wants=ModemManager.service ec20-failover.service
After=network-online.target ModemManager.service ec20-failover.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec20-console
Group=ec20-console
ExecStart=/opt/ec20-console/current/ec20-console -listen 192.0.2.10:8787 -credentials /etc/ec20-console/credentials.json -data-dir /var/lib/ec20-console -device-id 0000000000000000000000000000000000000000
Restart=on-failure
RestartSec=5
StateDirectory=ec20-console
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target

[Unit]
Description=EC20 Toolbox - unified HTTPS console and private audio gateway
Wants=ModemManager.service ec20-failover.service
After=network-online.target ModemManager.service ec20-failover.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec20-console
Group=ec20-console
LoadCredential=tls.crt:/etc/ec20-audio-loopback/server.crt
LoadCredential=tls.key:/etc/ec20-audio-loopback/server.key
LoadCredential=audio.key:/etc/ec20-console/audio-gateway.key
ExecStart=/opt/ec20-console/current/ec20-console -listen @PUBLIC_HOST@:8787 -credentials /etc/ec20-console/credentials.json -data-dir /var/lib/ec20-console -tls-listen @PUBLIC_HOST@:8788 -tls-cert %d/tls.crt -tls-key %d/tls.key -public-origin https://@PUBLIC_HOST@:8788 -audio-backend http://127.0.0.1:8790 -audio-gateway-key %d/audio.key -host-config /etc/ec20-toolbox/host.json @CONSOLE_FEATURES@
Restart=on-failure
RestartSec=5
StateDirectory=ec20-console
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target

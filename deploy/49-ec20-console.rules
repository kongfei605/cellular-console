// Voice, Messaging and Location are ModemManager's coarse authorizations. The application
// only exposes SMS Create/Send/state and voice control, never SMS deletion or
// storage changes. Location is used only for authenticated reads; GNSS Setup is
// isolated behind a local, peer-checked broker. The console user is never granted
// Device.Control/network/firmware privileges.
polkit.addRule(function(action, subject) {
    if (subject.user === "ec20-console" &&
        (action.id === "org.freedesktop.ModemManager1.Voice" ||
         action.id === "org.freedesktop.ModemManager1.Messaging" ||
         action.id === "org.freedesktop.ModemManager1.Location")) {
        return polkit.Result.YES;
    }
});

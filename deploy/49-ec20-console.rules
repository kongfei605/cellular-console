// This account can control voice calls, but cannot disable/reset the modem,
// edit network connections, flash firmware, or send SMS through privileged methods.
polkit.addRule(function(action, subject) {
    if (subject.user === "ec20-console" &&
        action.id === "org.freedesktop.ModemManager1.Voice") {
        return polkit.Result.YES;
    }
});

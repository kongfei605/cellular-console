[Unit]
Description=EC20 Toolbox - isolated private WebRTC audio backend (software loopback by default)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
User=ec20-audio-loopback
LoadCredential=audio.key:/etc/ec20-console/audio-gateway.key
ExecStart=/opt/ec20-audio-loopback/current/ec20-audio-loopback -listen 127.0.0.1:8790 -media @PUBLIC_HOST@:8789 -gateway-key %d/audio.key -host-config /etc/ec20-toolbox/host.json @AUDIO_FEATURES@
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_NETLINK
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
